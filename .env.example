# Copy to .env for LOCAL development only. Never commit real secrets.
APP_ENV=development
DEMO_MODE=true
# Demo accounts (viewer/operator/metallurgist/engineer/admin) are created ONLY if this is set (>= 10 chars)
DEMO_USER_PASSWORD=
# Leave empty locally -> ephemeral key (tokens invalid after restart). Set a long random value in production.
JWT_SECRET=
JWT_EXPIRE_MIN=480
ALLOW_ANONYMOUS_VIEWER=true
# Comma-separated list of allowed browser origins (the frontend URL). No wildcard in production.
CORS_ORIGINS=http://localhost:5173
# Empty -> SQLite under DATA_DIR. Render Postgres: postgresql://... (internal URL)
DATABASE_URL=
DATA_DIR=./data
PLANT_PRESET=large_4000
SIM_SPEED=30
SIM_AUTOSTART=true
RATE_LIMIT_PER_MIN=600
MAX_UPLOAD_MB=10
# Stored raw samples older than this (data time) are pruned
RAW_SAMPLE_RETENTION_DAYS=7
WORKER_THREADS=2
NMPC_TIME_BUDGET_S=45
# Background job safeguards: run-time limit, queue-wait limit, queued-job cap, finished jobs kept in memory
JOB_TIMEOUT_S=1800
JOB_QUEUE_TIMEOUT_S=900
JOB_MAX_PENDING=16
JOB_KEEP_IN_MEMORY=200
# Read-only edge gateway token (LIVE_MONITOR_ONLY ingestion). Leave empty to disable ingestion.
EDGE_INGEST_TOKEN=
DEPLOYMENT_TIER=cloud
# MUST remain false: this release contains no plant-write path and refuses to start if true.
ALLOW_PLANT_WRITES=false
LOG_LEVEL=INFO
