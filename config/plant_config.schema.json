                "maximum": 1
              },
              "h_in_W_m2K": {
                "type": "number",
                "minimum": 1,
                "maximum": 5000
              },
              "layers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "material",
                    "thickness_m"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "material": {
                      "enum": [
                        "carbon_micropore",
                        "cast_iron_stave",
                        "castable",
                        "ceramic_cup",
                        "chamotte",
                        "copper_stave",
                        "high_alumina",
                        "ramming_mass",
                        "semi_graphite",
                        "sic_si3n4",
                        "skull_accretion",
                        "steel_shell"
                      ]
                    },
                    "thickness_m": {
                      "type": "number",
                      "minimum": 0.005,
                      "maximum": 3.0
                    }
                  }
                },
                "minItems": 1,
                "maxItems": 8
              },
              "cooling": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "stave_water",
                      "bottom_water",
                      "spray",
                      "air"
                    ]
                  },
                  "water_flow_m3_h_per_m2": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "water_inlet_C": {
                    "type": "number",
                    "minimum": 5,
                    "maximum": 80
