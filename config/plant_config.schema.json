{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://extractmet.example/schemas/bf-plant-config-1.0.json",
  "title": "Blast furnace plant configuration (versioned)",
  "type": "object",
  "description": "Plant-scoped configuration of the BF digital twin. Illustrative defaults must be replaced by site data. Units are embedded in key names (SI or explicitly declared industrial units).",
  "required": [
    "schema_version",
    "plant",
    "geometry",
    "walls",
    "materials",
    "coke",
    "pci",
    "operation",
    "tapping",
    "targets",
    "equipment_limits",
    "rate_limits_per_15min",
    "model",
    "calibration",
    "economics",
    "carbon",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "plant": {
      "type": "object",
      "required": [
        "id",
        "name",
        "data_origin"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]{3,64}$"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "preset": {
          "type": "string"
        },
        "data_origin": {
          "enum": [
            "SYNTHETIC",
            "SITE"
          ]
        },
        "certified": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "geometry": {
      "type": "object",
      "required": [
        "hearth_diameter_m",
        "sump_depth_m",
        "taphole_to_tuyere_m",
        "bosh_height_m",
        "belly_diameter_m",
        "belly_height_m",
        "stack_height_m",
        "throat_diameter_m",
        "throat_height_m",
        "stockline_m",
        "n_tuyeres",
        "tuyere_diameter_m",
        "n_tapholes",
        "taphole_diameter_m"
      ],
      "properties": {
        "hearth_diameter_m": {
          "type": "number",
          "minimum": 3,
          "maximum": 20
        },
        "sump_depth_m": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 5
        },
        "taphole_to_tuyere_m": {
          "type": "number",
          "minimum": 1,
          "maximum": 6
        },
        "bosh_height_m": {
          "type": "number",
          "minimum": 1,
          "maximum": 8
        },
        "belly_diameter_m": {
          "type": "number",
          "minimum": 3,
          "maximum": 22
        },
        "belly_height_m": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 6
        },
        "stack_height_m": {
          "type": "number",
          "minimum": 5,
          "maximum": 30
        },
        "throat_diameter_m": {
          "type": "number",
          "minimum": 2,
          "maximum": 15
        },
        "throat_height_m": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 5
        },
        "stockline_m": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 4
        },
        "n_tuyeres": {
          "type": "integer",
          "minimum": 6,
          "maximum": 50
        },
        "tuyere_diameter_m": {
          "type": "number",
          "minimum": 0.06,
          "maximum": 0.2
        },
        "n_tapholes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "taphole_diameter_m": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 0.1
        },
        "deadman_porosity": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.6
        },
        "chute_length_m": {
          "type": "number",
          "minimum": 1,
          "maximum": 6
        }
      }
    },
    "walls": {
      "type": "object",
      "required": [
        "shaft",
        "sump_wall",
        "upper_hearth_wall",
        "hearth_bottom"
      ],
      "properties": {
        "shaft": {
          "type": "array",
